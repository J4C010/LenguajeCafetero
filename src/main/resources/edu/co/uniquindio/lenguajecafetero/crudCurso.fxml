<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="10.0" prefWidth="1000.0" prefHeight="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.co.uniquindio.lenguajecafetero.viewController.CursoViewController">
   <children>
      <Label text="Gestión de cursos">
         <font><Font name="System Bold" size="18.0" /></font>
      </Label>
      <GridPane hgap="10.0" vgap="8.0">
         <columnConstraints>
            <ColumnConstraints minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" />
            <ColumnConstraints minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" />
         </columnConstraints>
         <children>
            <Label text="Tipo de curso:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <ComboBox fx:id="cbTipo" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1" />
            <Label text="Código:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
            <TextField fx:id="txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="3" />
            <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1" />
            <Label text="Idioma:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
            <ComboBox fx:id="cbIdioma" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="3" />
            <Label text="Descripción:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField fx:id="txtDescripcion" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3" />
            <Label text="Duración (meses):" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <TextField fx:id="txtDuracion" GridPane.rowIndex="3" GridPane.columnIndex="1" />
            <Label text="Valor mensual:" GridPane.rowIndex="3" GridPane.columnIndex="2" />
            <TextField fx:id="txtValorMensual" GridPane.rowIndex="3" GridPane.columnIndex="3" />
            <Label text="Estado:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <ComboBox fx:id="cbEstado" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1" />
            <Label text="Beneficios:" GridPane.rowIndex="4" GridPane.columnIndex="2" />
            <HBox spacing="10.0" GridPane.rowIndex="4" GridPane.columnIndex="3">
               <children>
                  <CheckBox fx:id="chkPlataforma" text="Plataforma" />
                  <CheckBox fx:id="chkMaterial" text="Material" />
                  <CheckBox fx:id="chkClub" text="Club conversación" />
               </children>
            </HBox>
            <Label text="Horas semanales:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
            <TextField fx:id="txtHorasSemanales" promptText="Solo intensivo" GridPane.rowIndex="5" GridPane.columnIndex="1" />
            <Label text="Sesiones profesor:" GridPane.rowIndex="5" GridPane.columnIndex="2" />
            <TextField fx:id="txtSesiones" promptText="Solo personalizado" GridPane.rowIndex="5" GridPane.columnIndex="3" />
            <Label text="Nivel requerido:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
            <ComboBox fx:id="cbNivel" maxWidth="Infinity" promptText="Solo personalizado" GridPane.rowIndex="6" GridPane.columnIndex="1" />
            <Label text="Objetivos:" GridPane.rowIndex="6" GridPane.columnIndex="2" />
            <TextField fx:id="txtObjetivos" promptText="Solo personalizado" GridPane.rowIndex="6" GridPane.columnIndex="3" />
         </children>
      </GridPane>
      <HBox spacing="10.0">
         <children>
            <Button onAction="#onAgregarCurso" text="Agregar curso" />
            <Button onAction="#onActualizarCurso" text="Actualizar curso" />
            <Button onAction="#onEliminar" text="Eliminar" />
            <Button onAction="#onLimpiar" text="Limpiar" />
         </children>
      </HBox>
      <TableView fx:id="tblListCurso" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="tbcCodigo" prefWidth="80.0" text="Código" />
            <TableColumn fx:id="tbcNombre" prefWidth="170.0" text="Nombre" />
            <TableColumn fx:id="tbcTipo" prefWidth="110.0" text="Tipo" />
            <TableColumn fx:id="tbcIdioma" prefWidth="90.0" text="Idioma" />
            <TableColumn fx:id="tbcDuracion" prefWidth="80.0" text="Duración" />
            <TableColumn fx:id="tbcValor" prefWidth="110.0" text="Valor mensual" />
            <TableColumn fx:id="tbcEstado" prefWidth="90.0" text="Estado" />
            <TableColumn fx:id="tbcBeneficios" prefWidth="240.0" text="Beneficios" />
         </columns>
      </TableView>
      <Button onAction="#onVolver" text="← Volver al menú" />
   </children>
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
</VBox>
